  {
   "id": "te90",
   "type": "text",
   "x": 870,
   "y": 1385,
   "width": 1200,
   "height": 120,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
