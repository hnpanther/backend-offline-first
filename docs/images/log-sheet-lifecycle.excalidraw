   "frameId": null,
   "roundness": null,
   "seed": 1574963608,
   "version": 1,
   "versionNonce": 717440071,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• Every open sheet past its deadline becomes EXPIRED automatically — its readings are kept.\n• EXPIRED counts as missed in the compliance rate; so, for now, does CANCELLED (roadmap §47).\n• An approved sheet cannot be voided or reopened until its approval is withdrawn (system admin only).\n• Nothing a tablet sends is discarded: it is either accepted or kept for review.",
   "originalText": "• Every open sheet past its deadline becomes EXPIRED automatically — its readings are kept.\n• EXPIRED counts as missed in the compliance rate; so, for now, does CANCELLED (roadmap §47).\n• An approved sheet cannot be voided or reopened until its approval is withdrawn (system admin only).\n• Nothing a tablet sends is discarded: it is either accepted or kept for review.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
