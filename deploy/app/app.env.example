# Copy to app.env and fill in. app.env holds real credentials — keep it out of git
# (it is covered by .gitignore's env rules; check before the first commit) and chmod 600 it.
#
# Everything here is read by the application at start-up. The names are the environment-variable
# forms already present in src/main/resources/application.properties, so anything not listed can
# be added the same way.

# ---------------------------------------------------------------------------------------------
# The five settings the application WARNS about at every boot while they are on their defaults.
# If the bordered "CONFIGURATION STILL ON ITS SHIPPED DEFAULTS" block in the log is not empty,
# this file is not finished.
# ---------------------------------------------------------------------------------------------

# At least 32 bytes; 64 is better. Unique to this environment, and never the value in the
# repository: anyone who can read that one can forge a token for any user.
#   openssl rand -base64 48
APP_AUTH_JWT_SECRET=

# The PWA's real origin(s), comma-separated. Empty means no cross-origin caller is allowed,
# which is correct while the PWA is served from the same origin by nginx — the application warns
# about it rather than changing it, so an empty value here is a decision, not an oversight.
#
# ⚠ EMPTY AND COMMENTED OUT ARE OPPOSITES HERE. The property is
# `app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:*}` — the fallback is `*`. Leaving the
# line below with nothing after the `=` sets it to empty, which allows no cross-origin caller.
# Putting a `#` in front of it removes the variable, the fallback takes over, and /api/** then
# accepts EVERY origin. The boot block says which one you got: `APP_CORS_ALLOWED_ORIGINS is "*"`.
APP_CORS_ALLOWED_ORIGINS=

# Active Directory. Leave LDAP off entirely if the plant has no directory.
APP_AUTH_LDAP_ENABLED=false
#APP_AUTH_LDAP_URL=ldaps://dc1.site.local:636 ldaps://dc2.site.local:636
#APP_AUTH_LDAP_DOMAIN=site.local
#APP_AUTH_LDAP_TRUST_SELF_SIGNED=false
#APP_AUTH_LDAP_TRUSTSTORE=/certs/dc-truststore.p12
#APP_AUTH_LDAP_TRUSTSTORE_PASSWORD=
#APP_AUTH_LDAP_VERIFY_HOSTNAME=true

# The bootstrap admin (admin/admin123) is created only when no ADMIN user exists, and the
# application cannot see whether its password has been changed — that one is on you, at first login.

# ---------------------------------------------------------------------------------------------
# Database — on its own host in this topology.
# ---------------------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://10.0.0.11:5432/offline_first_db
SPRING_DATASOURCE_USERNAME=offline_app
SPRING_DATASOURCE_PASSWORD=

# Flyway runs the migrations on start-up as this user. If you follow the split-role setup in the
# README (a schema owner for migrations, a DML-only user at run time), migrate once with the
# owner and then set this to false — otherwise the DML-only user fails with error 42501, because
# Flyway creates its own history table first.
#SPRING_FLYWAY_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Paths — these must match the container side of the volumes in docker-compose.yml EXACTLY,
# and they must match the paths the image creates. Change both or neither.
#
# ⚠ `/data/attachments` is plural. deploy/Dockerfile creates and chowns exactly these four
# paths; a value of `/data/attachment` is a different directory that nothing prepared. With a
# named volume it silently works; with a bind mount on Linux it is root-owned and uid 10001
# cannot write to it — and the failure arrives at the first photograph an operator uploads, not
# at boot, so it survives every smoke test.
# sudo mkdir -p /srv/logsheet/{attachments,imports,template-guides,logs}
# sudo chown -R 10001:10001 /srv/logsheet
# sudo chmod 750 /srv/logsheet/*
# ---------------------------------------------------------------------------------------------
APP_ATTACHMENTS_STORAGE_DIR=/data/attachments
APP_IMPORT_STORAGE_PATH=/data/imports
APP_TEMPLATE_GUIDES_STORAGE_DIR=/data/template-guides
APP_LOG_PATH=/logs

# ---------------------------------------------------------------------------------------------
# The plant's clock. Not optional.
#
# Reports and the scheduler pin Asia/Tehran in code, so their numbers are safe either way — but
# the attachment directory is sharded by LocalDate.now() and Logback stamps lines with the system
# zone. A container without TZ runs on UTC, which puts photographs in yesterday's folder and
# every log line three and a half hours out.
# ---------------------------------------------------------------------------------------------
TZ=Asia/Tehran

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------
# Machine-readable logs on stdout, for a log collector. Same four files, different encoding.
#SPRING_PROFILES_ACTIVE=json-logs

# Behind a reverse proxy, once port 8081 is firewalled to the nginx host ONLY. Setting this
# before the port is closed makes a forged X-Forwarded-For easier to supply, not harder —
# see docs/roadmap.md §18b and §17.
#SERVER_FORWARD_HEADERS_STRATEGY=framework

# The port the application listens on INSIDE the container. Leave it alone: the published port
# in docker-compose.yml is what the outside world sees, and 8081 keeps the container identical to
# every other way of running this application. Changing it also means changing EXPOSE and the
# health probe in the Dockerfile.
#SERVER_PORT=8081

# Scheduler intervals, in milliseconds. The defaults are 60 s and are almost always right.
#APP_SCHEDULER_LOG_SHEET_GEN_MS=60000
#APP_SCHEDULER_LOG_SHEET_EXPIRY_MS=60000

# Attachment ceilings. Raising these is a MEMORY decision as much as a disk one: an upload and a
# download each hold the whole file in heap, so the arithmetic that matters is the container's
# memory limit in docker-compose.yml (see docs/roadmap.md §18m and the README's sizing section).
#APP_ATTACHMENTS_MAX_FILE_SIZE_BYTES=26214400
#APP_ATTACHMENTS_MAX_IMAGE_BYTES=5242880
#APP_ATTACHMENTS_MAX_AUDIO_BYTES=5242880
#APP_ATTACHMENTS_MAX_VIDEO_BYTES=20971520

# How many items one mobile sync batch may carry. 500 bounds the worst case; a real offline
# backlog is tens to low hundreds.
#APP_SYNC_BATCH_MAX_ITEMS=500

# The pre-change read behind every audited UPDATE borrows a second database connection while the
# caller's transaction holds its first. These bound that; the defaults are right unless you have
# measured otherwise (docs/jobs.md, "The pre-change read").
#APP_AUDIT_SNAPSHOT_MAX_CONCURRENT=4
#APP_AUDIT_SNAPSHOT_WAIT_MS=5000

# How many missed occurrences one tick may create after an outage. 0 means "resume from now",
# which is the honest answer: nobody walked the plant during the outage.
#APP_SCHEDULER_LOG_SHEET_MAX_BACKFILL=0

# ---------------------------------------------------------------------------------------------
# NOT here — the variables compose reads about itself
# ---------------------------------------------------------------------------------------------
# Everything above goes INTO the container because docker-compose.yml names this file under
# `env_file:`. Three variables work the other way round: compose substitutes them into the
# compose file itself, and it reads them from the shell or from a `.env` file BESIDE
# docker-compose.yml — never from here. Putting them in this file does nothing at all.
#
#   APP_VERSION   which image tag to run           default 1.0.0
#   APP_BIND_IP   the host address to publish on   default 127.0.0.1
#   APP_PORT      the host port to publish on      default 8081
#
# So, in deploy/app/.env (chmod 600 not needed — it holds no secret):
#
#   APP_VERSION=1.0.0
#   APP_BIND_IP=10.0.0.12
#   APP_PORT=8081
