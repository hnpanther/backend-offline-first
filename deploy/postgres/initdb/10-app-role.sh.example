#!/bin/bash
# Creates the two database roles the README's split-role setup describes, so the application can
# run with no DDL rights at all.
#
#   cp initdb/10-app-role.sh.example initdb/10-app-role.sh
#
# WHEN IT RUNS: once, by the postgres image's entrypoint, the first time the data volume is
# initialised — before the application has ever connected. On a volume that already holds a
# database, the entrypoint skips this directory entirely and nothing here happens. For an
# existing installation, run the same statements by hand as the superuser.
#
# IF APP_DB_USER / APP_DB_PASSWORD ARE EMPTY it does nothing, which is the simple setup: the
# application connects as the superuser and Flyway migrates on every boot.
#
# The SQL is the README's "Two database roles" section verbatim in intent — see it for why each
# line is there, in particular why ALTER DEFAULT PRIVILEGES is the line people leave out.
set -euo pipefail

if [ -z "${APP_DB_USER:-}" ] || [ -z "${APP_DB_PASSWORD:-}" ]; then
  echo "[initdb] APP_DB_USER/APP_DB_PASSWORD not set — leaving the single-role setup in place."
  exit 0
fi

echo "[initdb] creating the schema owner and the DML-only application role '${APP_DB_USER}'"

psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<-SQL
    -- Owns the schema and is what migrations run as. NOLOGIN: nothing ever connects as it.
    CREATE ROLE offline_owner NOLOGIN;

    -- What the application connects as at runtime. No DDL rights, ever.
    CREATE USER ${APP_DB_USER} WITH PASSWORD '${APP_DB_PASSWORD}';

    -- The database already exists (the entrypoint created it from POSTGRES_DB), so ownership is
    -- transferred rather than set at creation.
    ALTER DATABASE ${POSTGRES_DB} OWNER TO offline_owner;
    ALTER SCHEMA public OWNER TO offline_owner;

    -- Connect, and see inside the schema. USAGE alone allows reading no table.
    GRANT CONNECT ON DATABASE ${POSTGRES_DB} TO ${APP_DB_USER};
    GRANT USAGE   ON SCHEMA public           TO ${APP_DB_USER};

    -- Rights on whatever exists right now (nothing yet, on a fresh volume).
    GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO ${APP_DB_USER};

    -- ...and on the tables future migrations create. Without this line the application works
    -- today and fails after the next release, which is the worst possible timing.
    ALTER DEFAULT PRIVILEGES FOR ROLE offline_owner IN SCHEMA public
      GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO ${APP_DB_USER};

    -- Sequences: not needed by this schema (every key is GENERATED BY DEFAULT AS IDENTITY, and
    -- INSERT alone covers it), but harmless and correct if a future migration adds a serial.
    GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO ${APP_DB_USER};
    ALTER DEFAULT PRIVILEGES FOR ROLE offline_owner IN SCHEMA public
      GRANT USAGE, SELECT ON SEQUENCES TO ${APP_DB_USER};
SQL

echo "[initdb] done. Migrations must now be run as a member of offline_owner, and the"
echo "[initdb] application started with SPRING_FLYWAY_ENABLED=false — see docs/deployment.md."
