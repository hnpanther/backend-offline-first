# Copy to postgres.env, fill in, and `chmod 600 postgres.env`. It holds the database superuser's
# password. `*.env` is already in .gitignore.
#
# Read by docker-compose.postgres.yml on the database host.

# ---------------------------------------------------------------------------------------------
# The database and its superuser
# ---------------------------------------------------------------------------------------------

# Must match the database name in the application's SPRING_DATASOURCE_URL.
POSTGRES_DB=offline_first_db

# The superuser. Keep it `postgres` unless you have a reason; the application does not connect
# as this role in the split-role setup below.
POSTGRES_USER=postgres

# No default, by design: the container refuses to start without it. Generate one and store it
# wherever this site keeps credentials.
#   openssl rand -base64 36
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Initialisation — read ONCE, when the data volume is empty, and ignored for ever after
# ---------------------------------------------------------------------------------------------

# --data-checksums makes PostgreSQL verify every page it reads against a checksum, which is how
# silent disk corruption becomes an error instead of a wrong number years later. It costs a few
# percent of CPU and **cannot be turned on after initialisation** without a dump and restore, so
# it is on from the start.
#
# Encoding is UTF8 either way in this image; it is stated because every Persian label in this
# system depends on it.
#
# On COLLATION, deliberately left at the image default: the `ux_*_lower` indexes use lower(),
# which is identity for Persian letters, so the default sorts correctly for every uniqueness
# rule this schema has. ORDER BY on Persian text then sorts by code point, which is close to
# alphabetical but not perfect. If a site ever decides it must be exact (--locale-provider=icu
# --icu-locale=fa-IR), that is an initialisation-time decision too, and it has to match any dump
# you intend to restore — which in practice means deciding it before the first boot, once.
POSTGRES_INITDB_ARGS=--data-checksums --encoding=UTF8
#
# On PostgreSQL 18 --data-checksums is already the default (verified: a cluster initialised by
# this image with POSTGRES_INITDB_ARGS unset reports `Data page checksum version: 1`). It is
# still written out here, because the line states the intent for anyone who later pins an older
# major, where it was off by default and the mistake is unrecoverable without a dump and restore.

# ---------------------------------------------------------------------------------------------
# The application's own role — only used by initdb/10-app-role.sh, only on first initialisation
# ---------------------------------------------------------------------------------------------
#
# Leave BOTH of these empty for the simple setup, where the application connects as the superuser
# and Flyway runs its migrations on every boot. That is what the development database does and it
# is a legitimate choice for a single-purpose server.
#
# Fill them in for the split-role setup the README describes ("Two database roles"): a schema
# owner that migrations run as, and a DML-only user the application runs as, which cannot create
# or drop anything even if something goes very wrong. If you do:
#
#   * the application's SPRING_DATASOURCE_USERNAME/PASSWORD are these values;
#   * migrations must be run by the owner once per release, and the application then starts with
#     SPRING_FLYWAY_ENABLED=false — otherwise it fails with error 42501, because Flyway creates
#     its own history table first.
#
#APP_DB_USER=offline_app
#APP_DB_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Clock
# ---------------------------------------------------------------------------------------------
# The container's own zone, for log timestamps. The server settings `timezone` and `log_timezone`
# are set in the compose file; this keeps the two from disagreeing.
TZ=Asia/Tehran

# ---------------------------------------------------------------------------------------------
# NOT here — the variable compose reads about itself
# ---------------------------------------------------------------------------------------------
# Everything above goes INTO the container because docker-compose.yml names this file under
# `env_file:`. DB_BIND_IP works the other way round: compose substitutes it into the compose
# file's `ports:` line, and it reads it from the shell or from a `.env` file BESIDE
# docker-compose.yml — never from here. Putting it in this file does nothing at all, and what
# you get instead is the default, 127.0.0.1, which the application host cannot reach.
#
# So, in deploy/postgres/.env:
#
#   DB_BIND_IP=10.0.0.11
#
# ⚠ Not 0.0.0.0. A published port bypasses ufw — see the `ports:` comment in docker-compose.yml.
