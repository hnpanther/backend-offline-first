/mvnw text eol=lf
*.cmd text eol=crlf

# Anything a Linux host executes or parses line by line must arrive with LF, whatever the
# checkout platform does. core.autocrlf=true would otherwise hand a plant server a script whose
# shebang line ends in CR, and bash reports that as '/usr/bin/env bash^M: bad interpreter' —
# a file that looks perfect in every editor.
*.sh           text eol=lf
*.sh.example   text eol=lf
*.service      text eol=lf
*.timer        text eol=lf
# Copied to .env on the host and read by compose and by the postgres entrypoint.
*.env.example  text eol=lf
Dockerfile     text eol=lf
